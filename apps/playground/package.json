{
  "name": "@moyarich/moyaforge-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@moyarich/colorshower": "github:moyarich/colorshower",
    "@moyarich/console": "^0.1.0",
    "@moyarich/moyaforge": "*",
    "@moyarich/moyaforge-mdx": "*",
    "@moyarich/moyaforge-search-sqlite": "*",
    "lucide-react": "^1.56.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "scripts": {
    "dev": "npm run build --workspace @moyarich/moyaforge && npm run build --workspace @moyarich/moyaforge-mdx && npm run build --workspace @moyarich/moyaforge-search-sqlite && vite --host 0.0.0.0",
    "build": "npm run build --workspace @moyarich/moyaforge && npm run build --workspace @moyarich/moyaforge-mdx && npm run build --workspace @moyarich/moyaforge-search-sqlite && npm run check:legacy-imports && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:links": "npm run build --workspace @moyarich/moyaforge-mdx && node ./scripts/check-links.mjs",
    "test": "vitest run",
    "check:legacy-imports": "node ./scripts/check-legacy-framework-imports.mjs"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.5.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sql.js": "^1.15.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
