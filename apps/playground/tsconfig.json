{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUncheckedSideEffectImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "tests",
    "registry.config.ts",
    "vite.config.ts",
    "../../packages/moyaforge-ui/docs/**/*.ts",
    "../../packages/moyaforge-ui/docs/**/*.tsx"
  ]
}
