{
  "name": "@moyarich/moyaforge-cli",
  "version": "0.1.0",
  "description": "Initialize MoyaForge sites and install editable documentation components from GitHub",
  "type": "module",
  "license": "MIT",
  "bin": {
    "moyaforge": "./dist/bin/moyaforge.js"
  },
  "exports": {
    ".": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git",
    "directory": "packages/moyaforge-cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "homepage": "https://github.com/moyarich/moyaforge/tree/main/packages/moyaforge-cli#readme",
  "bugs": {
    "url": "https://github.com/moyarich/moyaforge/issues"
  }
}
