{
  "name": "@moyarich/moyaforge",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components.css": "./src/components.css",
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js"
    },
    "./mdx": {
      "types": "./dist/utils/mdx/index.d.ts",
      "import": "./dist/utils/mdx/index.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "import": "./dist/code.js"
    }
  },
  "files": [
    "dist",
    "src/components.css",
    "src/components/**/*.css",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git",
    "directory": "packages/moyaforge"
  },
  "description": "Reusable MDX and documentation infrastructure for MoyaForge-powered sites.",
  "peerDependencies": {
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": ">=4",
    "@moyarich/console": "^0.1.0",
    "@typefox/monaco-editor-react": ">=8",
    "monaco-languageclient": ">=11",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": "^7.18.4"
  },
  "scripts": {
    "build": "npm run build --workspace @moyarich/moyaforge-mdx && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node ../../scripts/copy-component-styles.mjs",
    "typecheck": "npm run build --workspace @moyarich/moyaforge-mdx && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@moyarich/console": "^0.1.0",
    "@typefox/monaco-editor-react": "^8.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "monaco-languageclient": "^11.0.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@moyarich/moyaforge-mdx": "^0.2.0"
  },
  "publisher": "moyarich",
  "author": "Moya Richards",
  "keywords": [
    "moyaforge",
    "react",
    "components",
    "documentation",
    "docs",
    "mdx",
    "ui"
  ],
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    },
    "@moyarich/console": {
      "optional": true
    },
    "@typefox/monaco-editor-react": {
      "optional": true
    },
    "monaco-languageclient": {
      "optional": true
    }
  }
}
