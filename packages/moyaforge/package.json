{
  "name": "@moyarich/moyaforge",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components.css": "./src/components.css"
  },
  "files": [
    "dist",
    "src/components.css",
    "src/components/**/*.css",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git",
    "directory": "packages/moyaforge"
  },
  "description": "Reusable MDX and documentation infrastructure for MoyaForge-powered sites.",
  "peerDependencies": {
    "@mdx-js/react": "^3.1.1",
    "react": ">=19",
    "react-dom": ">=19",
    "@typefox/monaco-editor-react": ">=8",
    "monaco-languageclient": ">=11",
    "@monaco-editor/react": ">=4",
    "@moyarich/console": "^0.1.0"
  },
  "scripts": {
    "build": "npm run build --workspace @moyarich/moyaforge-mdx && tsc -p tsconfig.json",
    "typecheck": "npm run build --workspace @moyarich/moyaforge-mdx && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "@types/react-dom": "^19.3.0",
    "@typefox/monaco-editor-react": "^8.0.2",
    "monaco-languageclient": "^11.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@moyarich/console": "^0.1.0",
    "@types/node": "^26.6.5"
  },
  "bin": {
    "moyaforge": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@moyarich/moyaforge-mdx": "^0.1.0"
  },
  "publisher": "moyarich",
  "author": "Moya Richards",
  "keywords": [
    "moyaforge",
    "react",
    "components",
    "documentation",
    "docs",
    "mdx",
    "ui"
  ]
}
