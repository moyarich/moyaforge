{
  "name": "@moyarich/moyaforge-monaco",
  "version": "0.1.0",
  "type": "module",
  "description": "Monaco React and TypeFox editor components, shared workspace UI, and Vite worker integrations.",
  "license": "MIT",
  "sideEffects": true,
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./typefox": {
      "types": "./dist/typefox.d.ts",
      "import": "./dist/typefox.js",
      "default": "./dist/typefox.js"
    },
    "./virtual": {
      "types": "./dist/virtual-modules.d.ts"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "default": "./dist/shared.js"
    },
    "./components/MonacoEditorReact": {
      "types": "./dist/components/MonacoEditorReact/index.d.ts",
      "import": "./dist/components/MonacoEditorReact/index.js",
      "default": "./dist/components/MonacoEditorReact/index.js"
    },
    "./components/MonacoEditorTypeFox": {
      "types": "./dist/components/MonacoEditorTypeFox/index.d.ts",
      "import": "./dist/components/MonacoEditorTypeFox/index.js",
      "default": "./dist/components/MonacoEditorTypeFox/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly && node -e \"require('node:fs').copyFileSync('src/virtual-modules.d.ts', 'dist/virtual-modules.d.ts')\" && node scripts/copy-component-css.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "vitest run tests"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "monaco-editor": "^0.52.0",
    "@monaco-editor/react": ">=4",
    "monaco-languageclient": "~11.0.2",
    "@codingame/monaco-vscode-standalone-languages": "^37.6.1",
    "@codingame/monaco-vscode-standalone-typescript-language-features": "^37.6.1",
    "@codingame/monaco-vscode-standalone-css-language-features": "^37.6.1",
    "@codingame/monaco-vscode-standalone-json-language-features": "^37.6.1",
    "@codingame/monaco-vscode-standalone-html-language-features": "^37.6.1",
    "@codingame/monaco-vscode-editor-api": "^37.6.1",
    "react": ">=18",
    "lucide-react": "^1.56.0",
    "@typefox/monaco-editor-react": "~8.0.2"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    },
    "@monaco-editor/react": {
      "optional": true
    },
    "monaco-languageclient": {
      "optional": true
    },
    "@codingame/monaco-vscode-standalone-languages": {
      "optional": true
    },
    "@codingame/monaco-vscode-standalone-typescript-language-features": {
      "optional": true
    },
    "@codingame/monaco-vscode-standalone-css-language-features": {
      "optional": true
    },
    "@codingame/monaco-vscode-standalone-json-language-features": {
      "optional": true
    },
    "@codingame/monaco-vscode-standalone-html-language-features": {
      "optional": true
    },
    "@codingame/monaco-vscode-editor-api": {
      "optional": true
    },
    "@typefox/monaco-editor-react": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git",
    "directory": "packages/moyaforge-monaco"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "author": "Moya Richards",
  "publisher": "moyarich",
  "keywords": [
    "moyaforge",
    "monaco",
    "editor",
    "react",
    "typefox",
    "vite",
    "typescript"
  ],
  "homepage": "https://github.com/moyarich/moyaforge/tree/main/packages/moyaforge-monaco#readme",
  "bugs": {
    "url": "https://github.com/moyarich/moyaforge/issues"
  }
}
