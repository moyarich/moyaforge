{
  "name": "@moyarich/moyaforge-search-sqlite",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone SQLite-backed documentation search indexing and querying",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git",
    "directory": "packages/moyaforge-search-sqlite"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": "./vite-plugin/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "vite-plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "sql.js": "^1.15.0",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "vite": "^8.3.4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "publisher": "moyarich",
  "author": "Moya Richards",
  "keywords": [
    "moyaforge",
    "sqlite",
    "search",
    "documentation",
    "full-text-search",
    "indexing",
    "vite"
  ]
}
