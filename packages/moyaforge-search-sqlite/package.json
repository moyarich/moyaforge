{
  "name": "@moyarich/moyaforge-search-sqlite",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone SQLite-backed documentation search indexing and querying",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git",
    "directory": "packages/moyaforge-search-sqlite"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": "./vite-plugin/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "vite-plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run --root ../.. packages/moyaforge-search-sqlite/tests",
    "prepack": "npm run build"
  },
  "dependencies": {
    "sql.js": "^1.14.2",
    "tinyglobby": "^0.2.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
