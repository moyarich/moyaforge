{
  "name": "moyaforge-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git"
  },
  "scripts": {
    "build:package": "npm run build --workspace @moyarich/moyaforge",
    "build:playground": "npm run build --workspace @moyarich/moyaforge-playground",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run typecheck && npm test && npm run check:links && npm run build && npm run test:unit && npm run test:consumer:browser",
    "check:links": "npm run check:links --workspace @moyarich/moyaforge-playground",
    "test:all": "npm run test",
    "test:boundaries": "vitest run tests/workspace.test.js",
    "test:consumer": "vitest run tests/consumer.test.js",
    "test:consumer:browser": "npm exec --workspace @moyarich/moyaforge-playground -- vite build --config ../../tests/vite-consumer-build/vite.config.js",
    "build": "npm run build --workspaces",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vitest": "^5.0.4",
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.4",
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
