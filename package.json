{
  "name": "moyaforge-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git"
  },
  "scripts": {
    "build:package": "npm run build --workspace @moyarich/moyaforge",
    "build:playground": "npm run build --workspace @moyarich/moyaforge-playground",
    "test": "npm test --workspace @moyarich/moyaforge",
    "typecheck": "npm run typecheck --workspace @moyarich/moyaforge",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run typecheck && npm run test:all && npm run check:links && npm run build && npm run test:boundaries && npm run test:consumer && npm run test:consumer:browser && npm run test:consumer:vitest",
    "check:links": "npm run check:links --workspace @moyarich/moyaforge-playground",
    "test:all": "npm test --workspaces --if-present",
    "test:boundaries": "node --test tests/workspace-boundaries.test.js",
    "test:consumer": "node --test tests/consumer-exports.test.js",
    "test:consumer:browser": "npm exec --workspace @moyarich/moyaforge-playground -- vite build --config ../../tests/vite-consumer-build/vite.config.js",
    "test:consumer:vitest": "vitest run tests/vite-consumer-build",
    "test:consumer:playwright": "playwright test",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.1"
  }
}
