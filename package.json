{
  "name": "moyaforge-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git"
  },
  "bin": {
    "build-registry": "./scripts/build-registry/build-registry-cli.ts",
    "moyaforge": "./packages/moyaforge-cli/dist/bin/moyaforge.js"
  },
  "scripts": {
    "dev": "npm run dev --workspace @moyarich/moyaforge-playground",
    "build:package": "npm run build --workspace @moyarich/moyaforge",
    "build:playground": "npm run build --workspace @moyarich/moyaforge-playground",
    "test": "vitest run tests",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run registry:check && npm run typecheck && npm test && npm run check:links && npm run build && npm run test:consumer:browser",
    "check:links": "npm run check:links --workspace @moyarich/moyaforge-playground",
    "test:boundaries": "vitest run tests/workspace.test.js",
    "test:consumer": "vitest run tests/consumer.test.js",
    "test:consumer:browser": "npm exec --workspace @moyarich/moyaforge-playground -- vite build --config ../../tests/vite-consumer-build/vite.config.js",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "playwright test --project=vite-consumer",
    "registry:build": "node scripts/build-registry/build-registry-cli.ts",
    "registry:check": "node scripts/build-registry/build-registry-cli.ts --check",
    "test:cli:browser": "playwright test --project=cli-consumer",
    "prepare": "npm run build --workspace @moyarich/moyaforge-cli"
  },
  "dependencies": {
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@codingame/monaco-vscode-api": "^37.6.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.31",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "overrides": {
    "@codingame/monaco-vscode-api": "$@codingame/monaco-vscode-api"
  },
  "files": [
    "packages/moyaforge-cli/dist/",
    "packages/moyaforge-cli/templates/",
    "packages/moyaforge-cli/package.json"
  ]
}
