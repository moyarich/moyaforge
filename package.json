{
  "name": "moyaforge-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git"
  },
  "scripts": {
    "dev": "npm run dev --workspace @moyarich/moyaforge-playground",
    "build:package": "npm run build --workspace @moyarich/moyaforge",
    "build:playground": "npm run build --workspace @moyarich/moyaforge-playground",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run registry:check && npm run typecheck && npm test && npm run check:links && npm run build && npm run pack:audit && npm run test:unit && npm run test:consumer:browser",
    "check:links": "npm run check:links --workspace @moyarich/moyaforge-playground",
    "test:all": "npm run test",
    "test:boundaries": "vitest run tests/workspace.test.js",
    "test:consumer": "vitest run tests/consumer.test.js",
    "test:consumer:browser": "npm exec --workspace @moyarich/moyaforge-playground -- vite build --config ../../tests/vite-consumer-build/vite.config.js",
    "build": "npm run build --workspaces",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "test:cli:consumer": "node tests/cli-consumer.mjs",
    "test:registry:consumer": "node tests/shadcn-consumer.mjs",
    "pack:audit": "node scripts/audit-framework-pack.mjs",
    "pack:audit:strict": "node scripts/audit-framework-pack.mjs --strict",
    "imports:audit": "node scripts/audit-framework-imports.mjs",
    "imports:audit:strict": "node scripts/audit-framework-imports.mjs --strict"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
