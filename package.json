{
  "name": "moyaforge-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git"
  },
  "scripts": {
    "build:package": "npm run build --workspace @moyarich/moyaforge",
    "build:playground": "npm run build --workspace @moyarich/moyaforge-playground",
    "test": "npm test --workspace @moyarich/moyaforge",
    "typecheck": "npm run typecheck --workspace @moyarich/moyaforge",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run typecheck && npm run test:all && npm run check:links && npm run build:playground && npm run test:boundaries && npm run test:consumer",
    "check:links": "npm run check:links --workspace @moyarich/moyaforge-playground",
    "test:all": "npm test --workspaces --if-present",
    "test:boundaries": "node --test tests/workspace-boundaries.test.js",
    "test:consumer": "npm run build --workspace @moyarich/moyaforge && npm run build --workspace @moyarich/moyaforge-search-sqlite && node --test tests/consumer-exports.test.js"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
